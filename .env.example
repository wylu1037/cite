# 复制为 .env 并修改（docker compose 和本地 dev 都会自动加载）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-please-32chars-min

# 数据库（compose 部署时由 compose 注入；本地 dev 用它连本机 postgres）
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# LLM（OpenAI 兼容；内网 vLLM 网关，dsv4 已实测可用）
OPENAI_API_BASE=http://172.31.11.11:3127/v1
OPENAI_API_KEY=EMPTY
LLM_MODEL_NAME=dsv4
# LLM_MAX_TOKENS=2048
# 不配置 OPENAI_API_KEY 时，问答自动降级为「检索片段直出」

# Embedding（EMBEDDING_API_URL 必须是完整接口地址，含 /v1/embeddings）
EMBEDDING_API_URL=http://172.31.11.10:8081/v1/embeddings
EMBEDDING_MODEL_NAME=Qwen3-Embedding-8B
EMBEDDING_API_KEY=
# 必须与端点实际输出维度一致（Qwen3-Embedding-8B 原生 4096）；
# 在内网机器上用 `node scripts/check-ai.mjs` 一键核对
EMBEDDING_DIM=4096
# 留空 EMBEDDING_API_URL 时本地自动用 mock 伪向量联调；也内置 dashscope/siliconflow 预设（设 EMBEDDING_PROVIDER）
