# 复制为 .env 并修改（docker compose 会自动加载）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-please-32chars-min

# AI（Ask AI + RAG）——默认阿里云百炼 text-embedding-v4（1024 维，0.5 元/百万 token，有免费额度）
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 零成本备选：SiliconFlow BAAI/bge-m3（免费，1024 维，单请求最多 32 条）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
